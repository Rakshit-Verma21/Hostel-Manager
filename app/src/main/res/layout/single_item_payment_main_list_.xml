<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="90dp"
    android:layout_margin="5dp"
    app:cardCornerRadius="3dp">

    <RelativeLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/payment_main_rv_image"
            android:layout_width="100dp"
            android:layout_height="80dp"
            android:layout_margin="5dp"
            android:elevation="6dp"
            tools:src="@drawable/pfp"></de.hdodenhof.circleimageview.CircleImageView>

        <TextView
            android:id="@+id/payment_main_rv_name"
            android:layout_width="180dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_marginTop="10dp"
            android:layout_toRightOf="@id/payment_main_rv_image"
            android:text="Tanya Srivastava"
            android:textColor="@color/light_blue_900"
            android:textSize="14sp"></TextView>

        <TextView
            android:id="@+id/payment_main_rv_room_number"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/payment_main_rv_name"
            android:layout_marginLeft="10dp"
            android:layout_toRightOf="@id/payment_main_rv_image"
            android:text="Room : Not Assigned"
            android:textColor="@color/light_blue_900"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/payment_main_rv_tv_status"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:layout_below="@id/payment_main_rv_room_number"
            android:layout_marginLeft="10dp"
            android:layout_toRightOf="@id/payment_main_rv_image"
            android:gravity="center"
            android:text="Payment Status : Paid"
            android:textColor="@color/black"
            android:textSize="12sp" />

        <ImageButton
            android:id="@+id/payment_main_ib_status"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_below="@id/payment_main_rv_room_number"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"
            android:layout_toRightOf="@id/payment_main_rv_tv_status"
            android:background="@drawable/status_paid"
            android:elevation="6dp"
            app:srcCompat="@drawable/baseline_check_circle_24" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"
            android:layout_toRightOf="@id/payment_main_rv_name"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="2dp">

            <Button
                android:id="@+id/payment_main_button_view"
                android:layout_width="60dp"
                android:layout_height="40dp"
                android:background="@drawable/main_activity_background"
                android:elevation="6dp"
                android:text="View"
                android:textColor="@color/black"
                android:textSize="12sp" />
        </LinearLayout>

    </RelativeLayout>


</androidx.cardview.widget.CardView>